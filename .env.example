# Copy to .env for local overrides. All values optional — the app runs without any of them.

# PostHog project API key. Empty = analytics is a silent no-op.
VITE_POSTHOG_KEY=

# PostHog host (only needed if not using the default US cloud).
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Public site URL used in the share card footer.
VITE_SITE_URL=https://peaks.gg

# Launch date (UTC) — day #1 of the Daily Summit. Drives the "Peaks #N" day index.
# PLACEHOLDER — founder to confirm the real launch date before Step 3.
VITE_LAUNCH_DATE=2026-09-01
